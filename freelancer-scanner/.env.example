# =============================================================================
# Freelancer Scanner – Konfiguration
#
# So gehst du vor:
#   1. Diese Datei kopieren und in ".env" umbenennen
#   2. Die Werte ausfüllen, die du brauchst
#   3. Die Datei ".env" NIEMALS ins Repository hochladen (steht in .gitignore)
#
# Zum Ausprobieren musst du gar nichts ausfüllen: mit DEMO_MODE=true
# funktioniert alles mit Beispieldaten.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. BETRIEBSMODUS
# -----------------------------------------------------------------------------
# true  = fünf Beispielprojekte, keine externen Zugriffe, keine Kosten
# false = echte Freelancer-API, echte KI-Bewertung, echtes Telegram
DEMO_MODE=true

# Wie gesprächig soll das Log sein? DEBUG, INFO, WARNING oder ERROR
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# 2. KI-ANBIETER  (nur nötig bei DEMO_MODE=false)
# -----------------------------------------------------------------------------
# anthropic = Claude, openai = ChatGPT, demo = keine echte KI
LLM_PROVIDER=demo

# Welches Modell verwendet wird.
#   Claude:  claude-opus-5     (stärkste Bewertung, teuerste Variante)
#            claude-sonnet-5   (deutlich günstiger, für Einstufungen meist ausreichend)
#            claude-haiku-4-5  (am günstigsten)
#   OpenAI:  gpt-4o-mini       (günstig)
# Siehe README, Abschnitt "Was kostet der Betrieb".
LLM_MODEL=claude-opus-5

# Trage nur den Schlüssel ein, der zu deinem LLM_PROVIDER passt.
# Claude:  https://console.anthropic.com  →  API Keys
ANTHROPIC_API_KEY=
# OpenAI:  https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Wie lange auf eine KI-Antwort gewartet wird (Sekunden)
LLM_TIMEOUT_SECONDS=120
# Wie oft bei ungültiger Antwort erneut gefragt wird
LLM_MAX_RETRIES=2


# -----------------------------------------------------------------------------
# 3. FREELANCER.COM  (nur nötig bei DEMO_MODE=false)
# -----------------------------------------------------------------------------
# OAuth-Token aus deinem Freelancer-Entwicklerkonto.
# Anleitung: siehe README, Schritt 3.
FREELANCER_OAUTH_TOKEN=

FREELANCER_API_BASE=https://www.freelancer.com/api
FREELANCER_TIMEOUT_SECONDS=30
# Pause zwischen zwei Suchanfragen in Sekunden (schützt vor Rate-Limits).
# Nicht unter 1.0 setzen.
FREELANCER_REQUEST_DELAY_SECONDS=1.5
# Nur Projekte berücksichtigen, die jünger sind als X Stunden
FREELANCER_MAX_AGE_HOURS=24


# -----------------------------------------------------------------------------
# 4. TELEGRAM  (nur nötig bei DEMO_MODE=false)
# -----------------------------------------------------------------------------
# Anleitung zum Anlegen: siehe README, Schritt 5.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# -----------------------------------------------------------------------------
# 5. SCANNER
# -----------------------------------------------------------------------------
# Wie oft nach neuen Projekten gesucht wird.
# Wichtig: gute Projekte sind auf Freelancer.com nach 15–30 Minuten meist
# schon vergeben. Ein kurzes Intervall ist hier bares Geld wert.
SCAN_INTERVAL_MINUTES=5

# false = kein automatischer Scan, nur der Button im Dashboard
SCANNER_ENABLED=true


# -----------------------------------------------------------------------------
# 6. DATENBANK
# -----------------------------------------------------------------------------
# Standard ist SQLite – eine einzelne Datei unter data/projects.db.
# Es ist keine Installation nötig.
DATABASE_URL=sqlite:///./data/projects.db

# Für den späteren Wechsel auf Supabase/PostgreSQL genügt es,
# die Zeile oben durch diese hier zu ersetzen (mit deinen Daten):
# DATABASE_URL=postgresql+psycopg://benutzer:passwort@host:5432/datenbank
